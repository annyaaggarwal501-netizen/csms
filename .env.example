# Copy this file to ".env" (same folder as pom.xml) and fill in your values.
# One setting per line, KEY=value. No quotes, no spaces around "=".
# .env is in .gitignore: never put it on GitHub or WhatsApp - it holds the database password.

# ---- Neon cloud database (PostgreSQL) - the shared shop database ----
# From Neon console -> Connect (Connection pooling OFF). Host must NOT contain "-pooler".
DB_HOST=ep-your-endpoint-123456.c-3.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=paste-the-neon-password-here
DB_SSL_MODE=require

# ---- Local PostgreSQL on your laptop instead (delete the block above, use this) ----
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=clothing_shop
# DB_USER=csms
# DB_PASSWORD=csms_dev_pw
# DB_SSL_MODE=prefer

# ---- Optional ----
# PUBLIC_BASE_URL=https://your-live-link.example.com
# LINK_SECRET=put-a-long-random-text-here
